// (No .js extension: node --test would run it as a test file.)
// A stand-in for the `sideload` binary in the slot lending tests, run through a small wrapper script. FAKE_DIR gets one line per call in
// calls.log (argv, SIDELOAD_HOME and PATH as the call saw them). A `slot` call answers the next envelope in FAKE_DIR/answers.json (an
// array; the last one is repeated), or by FAKE_MODE: ok | sleep (never answers; ends quietly on SIGTERM) | term-json (never answers;
// prints the INTERRUPTED envelope on SIGTERM) | ignore-term (never answers; ignores SIGTERM) | garbage (prints text that is not JSON).
// `status` prints FAKE_DIR/status.json when there is one.
import fs from 'node:fs';
import path from 'node:path';

const mode = process.env.FAKE_MODE || 'ok';
const dir = process.env.FAKE_DIR;
const argv = process.argv.slice(2);
if (dir) fs.appendFileSync(path.join(dir, 'calls.log'), `${JSON.stringify({ argv, home: process.env.SIDELOAD_HOME ?? null, path: process.env.PATH ?? null })}\n`);

const out = v => process.stdout.write(`${JSON.stringify(v)}\n`);
const hang = () => setInterval(() => {}, 1 << 30);

if (argv[0] === 'status') {
  const f = path.join(dir, 'status.json');
  if (fs.existsSync(f)) process.stdout.write(fs.readFileSync(f, 'utf8'));
} else if (mode === 'sleep') {
  process.on('SIGTERM', () => process.exit(143));
  hang();
} else if (mode === 'term-json') {
  process.on('SIGTERM', () => {
    out({ ok: false, command: 'slot', action: argv[1], errors: [{ code: 'INTERRUPTED', message: 'interrupted', fix: 'run it again' }] });
    process.exit(130);
  });
  hang();
} else if (mode === 'ignore-term') {
  process.on('SIGTERM', () => {});
  fs.writeFileSync(path.join(dir, 'tool.pid'), String(process.pid));
  hang();
} else if (mode === 'garbage') {
  process.stdout.write('sideload: something went wrong\n');
} else {
  const file = path.join(dir, 'answers.json');
  const answers = fs.existsSync(file) ? JSON.parse(fs.readFileSync(file, 'utf8')) : [{ ok: true, command: 'slot', action: argv[1] }];
  const countFile = path.join(dir, 'slot-count');
  const n = (fs.existsSync(countFile) ? Number(fs.readFileSync(countFile, 'utf8')) : 0) + 1;
  fs.writeFileSync(countFile, String(n));
  out(answers[Math.min(n, answers.length) - 1]);
}
