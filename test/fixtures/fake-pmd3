// (No .js extension: node --test would run it as a test file.)
// A stand-in for pymobiledevice3 in the tunnel tests, run through a small wrapper script.
// FAKE_MODE: ok | wrong-udid | silent | exit-early | rsd-fail-twice | rsd-fail | start-fail | rsd-slow | no-device. FAKE_UDID is the
// UDID rsd-info reports; FAKE_DIR gets one line per call in calls.log (argv, whether stdin is
// /dev/null, the COLUMNS and PYMOBILEDEVICE3_UDID it was started with) and the rsd-info count.
import fs from 'node:fs';
import path from 'node:path';

const mode = process.env.FAKE_MODE || 'ok';
const dir = process.env.FAKE_DIR;
const argv = process.argv.slice(2);
let stdinNull = false;
try { stdinNull = fs.fstatSync(0).isCharacterDevice() && fs.fstatSync(0).rdev === fs.statSync('/dev/null').rdev; } catch { /* closed */ }
if (dir) fs.appendFileSync(path.join(dir, 'calls.log'), `${JSON.stringify({ argv, stdinNull, columns: process.env.COLUMNS ?? null, udidEnv: process.env.PYMOBILEDEVICE3_UDID ?? null })}\n`);

if (argv[0] === 'version') {
  process.stdout.write('11.40.2\n');
} else if (argv[0] === 'remote' && argv[1] === 'start-tunnel') {
  if (mode === 'no-device') {
    process.stderr.write('ERROR: No device connected\n');
    process.exit(1);
  }
  if (mode === 'start-fail') { // exits with the text in FAKE_START_STDERR (a file)
    process.stderr.write(fs.readFileSync(process.env.FAKE_START_STDERR, 'utf8'));
    process.exit(1);
  }
  fs.writeFileSync(path.join(dir, 'tool.pid'), String(process.pid));
  process.on('SIGTERM', () => process.exit(0));
  if (mode !== 'silent') process.stdout.write('fd00:1234::1 54321\n');
  if (mode === 'exit-early') setTimeout(() => process.exit(2), Number(process.env.FAKE_EXIT_MS || 300));
  setInterval(() => {}, 1 << 30);
} else if (argv[0] === 'remote' && argv[1] === 'rsd-info' && mode === 'rsd-slow') {
  fs.writeFileSync(path.join(dir, 'rsd.pid'), String(process.pid));
  setInterval(() => {}, 1 << 30);
} else if (argv[0] === 'remote' && argv[1] === 'rsd-info') {
  const countFile = path.join(dir, 'rsd-count');
  const n = (fs.existsSync(countFile) ? Number(fs.readFileSync(countFile, 'utf8')) : 0) + 1;
  fs.writeFileSync(countFile, String(n));
  if (mode === 'rsd-fail') { // always, with the text in FAKE_RSD_STDERR (a file)
    process.stderr.write(fs.readFileSync(process.env.FAKE_RSD_STDERR, 'utf8'));
    process.exit(1);
  }
  if (mode === 'rsd-fail-twice' && n <= 2) {
    process.stderr.write('ConnectionTerminatedError\n');
    process.exit(1);
  }
  const udid = mode === 'wrong-udid' ? '00008000-0000000000000BAD' : process.env.FAKE_UDID;
  process.stdout.write(JSON.stringify({
    MessageType: 'Handshake',
    Properties: { UniqueDeviceID: udid, ProductType: 'iPhone16,2', OSVersion: process.env.FAKE_OSVERSION || '27.0.1' },
    Services: { 'com.apple.webinspector.shim.remote': { Port: '53001', Entitlement: 'x' }, 'com.apple.dt.testmanagerd.remote': { Port: '53002' }, broken: { Port: 'x' } },
  }));
} else {
  process.stderr.write(`fake-pmd3: unexpected ${argv.join(' ')}\n`);
  process.exit(64);
}
